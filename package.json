{
  "name": "game-aggregator",
  "version": "1.0.0",
  "main": "dist/index.cjs",
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs",
    "serve": "drizzle-kit migrate && node .",
    "docker:local": "npm i && drizzle-kit migrate && npm run seed:initial-data && nodemon --exec tsx src/main.ts",
    "seed-game-simulation": "npx tsx seeders/seed-game-simulation.ts",
    "k6-create-users": "npx tsx seeders/create-users.ts",
    "generate-tokens-csv": "npx tsx seeders/generate-tokens-csv.ts",
    "seed:k6-initial-data": "npm run k6-create-users && npm run generate-tokens-csv && npm run create-game-session",
    "create-wallets": "npx tsx seeders/create-wallets.ts",
    "create-deposits-all-users": "npx tsx seeders/create-deposits-all-users.ts",
    "create-game": "npx tsx seeders/create-game.ts",
    "create-game-session": "npx tsx seeders/create-game-session.ts",
    "create-bets": "npx tsx seeders/create-bets.ts",
    "create-email": "npx tsx seeders/create-email.ts",
    "seed-new-game": "npx tsx seeders/seed-new-game.ts",
    "seed:transactions": "npx tsx seeders/seed-dummy-transactions.ts",
    "seed:test-game-and-users": "npx tsx seeders/testGameAndUsersSeeder.ts",
    "seed:leaderboard-users": "ts-node seeders/leaderboard-users.ts",
    "seed:transaction-wonprize": "ts-node seeders/seed-transaction-wonprize.ts",
    "seed:leaderboard": "npm run seed:leaderboard-users && npm run seed:transaction-wonprize",
    "seed:transaction-report": "npx tsx seeders/transaction-report-seeder.ts",
    "import:banned-players": "npx tsx seeders/upload-banned-players.ts",
    "recreate-db": "ts-node recreateDb.ts",
    "seed:studios": "ts-node seeders/seed-studios.ts",
    "seed:initial-data": "npm run seed:test-game-and-users && npm run seed:studios && npm run create-game-session",
    "seed:chat-session-types": "ts-node seeders/chat-session-types.ts",
    "seed:player-transactions": "ts-node seeders/player-transactions.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/redis": "^7.0.2",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.2.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.4.0",
    "luxon": "^3.7.1",
    "moment": "^2.30.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "bcrypt": "^6.0.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.9",
    "esbuild-plugin-external-package": "^1.0.0",
    "exceljs": "^4.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
